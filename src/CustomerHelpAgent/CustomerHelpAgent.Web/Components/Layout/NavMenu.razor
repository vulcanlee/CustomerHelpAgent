<div class="top-row navbar-dark @(IsSidebarCollapsed ? "top-row-collapsed" : string.Empty)">
    <button type="button"
            class="sidebar-hamburger"
            @onclick="ToggleSidebar"
            aria-label="切換側邊欄"
            aria-expanded="@(!IsSidebarCollapsed)"
            title="@(IsSidebarCollapsed ? "展開側邊欄" : "收起側邊欄")">
        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                      Kind="@(IsSidebarCollapsed ? "menu_open" : "menu")" />
    </button>

    <div class="sidebar-brand @(IsSidebarCollapsed ? "sidebar-brand-collapsed" : string.Empty)">
        <div class="sidebar-brand-text">
            <a class="navbar-brand" href="" title="@SystemName">@SystemName</a>
            <div class="navbar-subtitle">管理後台功能清單</div>
        </div>
    </div>
</div>

<div class="nav-scrollable @(IsSidebarCollapsed ? "nav-scrollable-collapsed" : string.Empty)">
    <div class="sidebar-menu-shell @(IsSidebarCollapsed ? "sidebar-menu-shell-collapsed" : string.Empty)">
        <div class="nav-section-title">功能選單</div>
        @if (MenuItems.Count == 0)
        {
            <div class="nav-item px-3">
                <span class="nav-link nav-link-disabled">尚無可用選單</span>
            </div>
        }
        else if (IsSidebarCollapsed)
        {
            <nav class="collapsed-sidebar-menu" aria-label="收合功能選單">
                <ul class="collapsed-menu-list">
                    @for (var index = 0; index < MenuItems.Count; index++)
                    {
                        var item = MenuItems[index];
                        var itemKey = $"root-{index}";

                        <li class="@GetCollapsedItemClass(itemKey)">
                            @if (item.HasChildren)
                            {
                                <button type="button"
                                        class="collapsed-menu-trigger"
                                        aria-label="@item.Name"
                                        aria-haspopup="menu"
                                        title="@item.Name">
                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                  Kind="@GetMaterialIconKind(item)"
                                                  Size="@MaterialIconOpticalSize.For(GetMaterialIconKind(item))" />
                                </button>

                                @* 群組型子項（無 url）本身不是連結，而是一列可懸停的觸發鈕，
                                   往右再彈出自己的第二層 flyout —— 收合時同樣維持三層階層，
                                   不把孫節點一次攤平在同一層。 *@
                                <div class="collapsed-menu-flyout" role="menu" aria-label="@item.Name">
                                    @for (var childIndex = 0; childIndex < item.SubMenu.Count; childIndex++)
                                    {
                                        var child = item.SubMenu[childIndex];
                                        var childKey = $"{itemKey}-{childIndex}";

                                        @if (child.HasChildren)
                                        {
                                            <div class="collapsed-flyout-group">
                                                <button type="button"
                                                        class="@GetCollapsedFlyoutGroupClass(childKey)"
                                                        aria-haspopup="menu"
                                                        title="@child.Name">
                                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                                  Kind="@GetMaterialIconKind(child)"
                                                                  Size="@MaterialIconOpticalSize.For(GetMaterialIconKind(child))" />
                                                    <span class="collapsed-flyout-group-label">@child.Name</span>
                                                    <span class="collapsed-flyout-group-arrow">
                                                        <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                                      Kind="chevron_right" />
                                                    </span>
                                                </button>

                                                <div class="collapsed-menu-flyout collapsed-flyout-submenu" role="menu" aria-label="@child.Name">
                                                    @for (var grandChildIndex = 0; grandChildIndex < child.SubMenu.Count; grandChildIndex++)
                                                    {
                                                        var grandChild = child.SubMenu[grandChildIndex];
                                                        var grandChildKey = $"{childKey}-{grandChildIndex}";

                                                        @if (!string.IsNullOrWhiteSpace(grandChild.Url))
                                                        {
                                                            <a class="@GetCollapsedFlyoutItemClass(grandChildKey)"
                                                               href="@grandChild.Url"
                                                               role="menuitem">
                                                                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                                              Kind="@GetMaterialIconKind(grandChild)"
                                                                              Size="@MaterialIconOpticalSize.For(GetMaterialIconKind(grandChild))" />
                                                                <span>@grandChild.Name</span>
                                                            </a>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(child.Url))
                                        {
                                            <a class="@GetCollapsedFlyoutItemClass(childKey)"
                                               href="@child.Url"
                                               role="menuitem">
                                                <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                              Kind="@GetMaterialIconKind(child)"
                                                              Size="@MaterialIconOpticalSize.For(GetMaterialIconKind(child))" />
                                                <span>@child.Name</span>
                                            </a>
                                        }
                                    }
                                </div>
                            }
                            else if (LogoutConfirm.IsLogoutUrl(item.Url))
                            {
                                @*
                                    登出不直接連過去 —— 先問過使用者。沿用 collapsed-menu-link
                                    的 class，外觀與其他收合項一致（有子選單的項目本來就是 button）。
                                *@
                                <button type="button"
                                        class="collapsed-menu-trigger collapsed-menu-link"
                                        aria-label="@item.Name"
                                        title="@item.Name"
                                        @onclick="OnLogoutClickAsync">
                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                  Kind="@GetMaterialIconKind(item)"
                                                  Size="@MaterialIconOpticalSize.For(GetMaterialIconKind(item))" />
                                </button>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <a class="collapsed-menu-trigger collapsed-menu-link"
                                   href="@item.Url"
                                   aria-label="@item.Name"
                                   title="@item.Name">
                                    <MaterialIcon Theme="@MaterialIcon.Themes.Outlined"
                                                  Kind="@GetMaterialIconKind(item)"
                                                  Size="@MaterialIconOpticalSize.For(GetMaterialIconKind(item))" />
                                </a>
                            }
                        </li>
                    }
                </ul>
            </nav>
        }
        else
        {
            <Menu Class="sidebar-menu"
                  Mode="MenuMode.Inline"
                  Theme="MenuTheme.Light"
                  InlineCollapsed="false"
                  SelectedKeys="SelectedKeys"
                  OpenKeys="OpenKeys"
                  OpenKeysChanged="HandleOpenKeysChanged">
                @for (var index = 0; index < MenuItems.Count; index++)
                {
                    <SidebarMenuNode Item="MenuItems[index]"
                                     ItemKey="@($"root-{index}")"
                                     OnLogoutCancelled="RestoreMenuSelection" />
                }
            </Menu>
        }
    </div>
</div>
