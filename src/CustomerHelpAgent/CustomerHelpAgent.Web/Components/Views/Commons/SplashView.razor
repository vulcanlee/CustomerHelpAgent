<section class="splash-shell" aria-label="系統啟動畫面">
    <div class="splash-card">
        <div class="splash-brand">
            <div class="splash-brand-image-wrap">
                <img class="splash-brand-image"
                     src="@Assets["images/brand-logo.png"]"
                     alt="系統品牌圖示" />
            </div>

            <div class="splash-brand-copy">
                <p class="splash-eyebrow">Welcome</p>
                <h1 class="splash-title">@SystemName</h1>
                <p class="splash-description">@SystemDescription</p>
            </div>
        </div>

        <div class="splash-status" aria-live="polite">
            <span class="splash-status-dot"></span>
            <span>系統載入中，正在為你準備工作環境...</span>
        </div>
    </div>
</section>
