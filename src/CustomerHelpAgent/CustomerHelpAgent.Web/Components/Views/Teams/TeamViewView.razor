@* 權限判定完成前不渲染任何內容，否則沒有權限的人會先看到頁面框架（PageAuthorizationTests 守門）。 *@
@if (!isAccessChecked)
{
}
else if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    <div>
        <div class="team-view-toolbar">
            <div class="team-view-toolbar-left">
                @if (!showDeleted)
                {
                    <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Create">
                        <ToolbarIconButton Title="新增" Icon="add"
                                           OnClick="@(async () => await OnAddAsync())" />
                    </RequirePermission>
                }
                <ToolbarIconButton Title="重新整理" Icon="refresh"
                                   OnClick="@(async () => await OnRefreshAsync())" />
                @* 0.9.107 起：依目前的搜尋、篩選、排序與「顯示已刪除」匯出（團隊範圍與畫面相同）。 *@
                <ToolbarIconButton Title="匯出 Excel" Icon="file_download"
                                   OnClick="@(async () => await OnExportExcelAsync())" />
                @if (!showDeleted)
                {
                    <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Delete">
                        <BatchDeleteButton Count="@selectedRows.Count()" Busy="@batchDeleting"
                                           OnClick="@(async () => await OnBatchDeleteAsync())" />
                    </RequirePermission>
                }
                <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Delete">
                    @* 0.9.94 起刪除為軟刪除：切換到已刪除的資料，可還原或永久刪除。 *@
                    <ToolbarIconButton Title="@(showDeleted ? "返回清單" : "顯示已刪除")"
                                       Icon="@(showDeleted ? "arrow_back" : "auto_delete")"
                                       OnClick="@(async () => await OnToggleDeletedAsync())" />
                </RequirePermission>
            </div>
            <div class="team-view-toolbar-right">
                <Input class="team-view-search-input" @bind-Value="searchText" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <ToolbarIconButton Title="清空搜尋" Icon="close"
                                       OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })" />
                }
                <ToolbarIconButton Title="搜尋" Icon="search"
                                   OnClick="@(async () => await OnSearchAsync())" />
            </div>
        </div>
        <div class="team-view-table-wrap">
            <Table @ref="table"
                   TItem="TeamAdapterModel"
                   Class="team-view-table"
                   RemoteDataSource="true"
                   DataSource="@teamAdapterModels"
                   OnChange="OnTableChange"
                   TreeChildren="ChildrenOf"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total"
                   @bind-SelectedRows="selectedRows">
                @* 0.9.105 起：沒有搜尋、不是「顯示已刪除」時是部門樹（下屬部門收在上層底下，分頁以最上層計）；其他時候是平面清單。 *@
                @*
                    0.9.132 起：勾選後可「刪除選取」；已刪除的資料不可勾選。
                    CheckStrictly：勾上層不連帶勾下屬 —— 只刪使用者親手勾的，不會刪到收合在底下沒看到的部門。
                *@
                @if (!showDeleted)
                {
                    <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Delete">
                        <Selection CheckStrictly="true" />
                    </RequirePermission>
                }
                <Column TData="string" DataIndex="@nameof(TeamAdapterModel.Name)" Title="名稱" Sortable />
                @if (!IsTreeMode)
                {
                    <Column TData="int?" DataIndex="@nameof(TeamAdapterModel.ParentId)" Title="上層部門">
                        @ParentNameOf(context)
                    </Column>
                }
                <Column TData="string" DataIndex="@nameof(TeamAdapterModel.Code)" Title="代號" Sortable />
                <Column TData="string" DataIndex="@nameof(TeamAdapterModel.Description)" Title="描述" />
                <Column TData="bool" DataIndex="@nameof(TeamAdapterModel.IsEnabled)" Title="啟用狀態" Sortable>
                    @* 0.9.120 起：有修改權限時點標籤直接切換（停用先確認）；已刪除的資料不可點。 *@
                    @if (showDeleted)
                    {
                        <StatusPill Text="@(context.IsEnabled ? "啟用" : "停用")"
                                    Tone="@(context.IsEnabled ? StatusTone.Positive : StatusTone.Muted)" />
                    }
                    else
                    {
                        <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Edit">
                            <ChildContent>
                                <StatusPill Text="@(context.IsEnabled ? "啟用" : "停用")"
                                            Tone="@(context.IsEnabled ? StatusTone.Positive : StatusTone.Muted)"
                                            Hint="@(context.IsEnabled ? "點一下切換為停用" : "點一下切換為啟用")"
                                            OnClick="@(async () => await OnToggleEnabledAsync(context))" />
                            </ChildContent>
                            <Fallback>
                                <StatusPill Text="@(context.IsEnabled ? "啟用" : "停用")"
                                            Tone="@(context.IsEnabled ? StatusTone.Positive : StatusTone.Muted)" />
                            </Fallback>
                        </RequirePermission>
                    }
                </Column>
                <Column TData="DateTime" DataIndex="@nameof(TeamAdapterModel.UpdatedAt)" Title="更新時間" Sortable DefaultSortOrder="SortDirection.Descending" />
                @if (showDeleted)
                {
                    <Column TData="DateTime?" DataIndex="@nameof(TeamAdapterModel.DeletedAt)" Title="刪除時間" />
                    <Column TData="string" DataIndex="@nameof(TeamAdapterModel.DeletedBy)" Title="刪除者" />
                }
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    @if (showDeleted)
                    {
                        <Space>
                            <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Delete">
                                <SpaceItem>
                                    <CrudActionButton Title="還原" Icon="restore_from_trash"
                                                      OnClick="@(async () => await OnRestoreAsync(@context))" />
                                </SpaceItem>
                                <SpaceItem>
                                    <CrudActionButton Title="永久刪除" Icon="delete_forever" Danger
                                                      OnClick="@(async () => await OnPurgeAsync(@context))" />
                                </SpaceItem>
                            </RequirePermission>
                        </Space>
                    }
                    else
                    {
                        <Space>
                            <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Edit">
                                <SpaceItem>
                                    <CrudActionButton Title="修改" Icon="edit"
                                                      OnClick="@(async () => await OnEditAsync(@context))" />
                                </SpaceItem>
                            </RequirePermission>
                            <RequirePermission Page="@MagicObjectHelper.角色_團隊清單" Action="@PermissionActions.Delete">
                                <SpaceItem>
                                    <CrudActionButton Title="刪除" Icon="delete" Danger
                                                      OnClick="@(async () => await OnDeleteAsync(@context))" />
                                </SpaceItem>
                            </RequirePermission>
                        </Space>
                    }
                </ActionColumn>
            </Table>
        </div>
    </div>

    @*
        大量資料輸入對話窗，規範見 docs/architecture/對話窗 UI 設計規範.md。
        ⚠️ EditForm 上絕不可掛鍵盤事件（§6.3，ModalKeyboardConventionTests 守門）。
    *@
    <Modal Title="@modalTitle"
           Class="form-modal"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           MaskClosable="false"
           OkText="@("儲存")"
           CancelText="@("取消")"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <EditForm Model="@CurrentRecord" Context="editContext">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <InputWatcher EditContextActionChanged="OnEditContestChanged" />

            <AntDesign.Form TModel="TeamAdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                <FormSection Title="團隊資料">
                    <FormItem Label="名稱" Required>
                        <Input @bind-Value="CurrentRecord.Name" Placeholder="請輸入團隊名稱" />
                        <ValidationMessage For="() => CurrentRecord.Name" />
                        @if (!isNewRecordMode)
                        {
                            <div class="team-view-hint">改名時，專案、分類與角色預設團隊裡的這個名稱會一起改。</div>
                        }
                    </FormItem>

                    <FormItem Label="上層部門">
                        <Select TItem="string" TItemValue="string" @bind-Value="ParentIdText"
                                Placeholder="（最上層）" AllowClear EnableSearch Style="width: 100%;">
                            @foreach (var candidate in parentCandidates)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@candidate.Id.ToString()">@candidate.Name</SelectOption>
                            }
                        </Select>
                        <div class="team-view-hint">上層部門的成員看得到這個部門與它所有下屬部門的資料。自己和自己的下屬部門不在選項裡。</div>
                    </FormItem>

                    <FormItem Label="代號">
                        <Input @bind-Value="CurrentRecord.Code" Placeholder="請輸入團隊代號（選填，有填則需唯一）" />
                        <ValidationMessage For="() => CurrentRecord.Code" />
                    </FormItem>

                    @* 多行文字獨占整行：擠在半欄裡會逼使用者在窄框裡讀長句。 *@
                    <FormItem Label="描述" Class="form-field-full">
                        <TextArea @bind-Value="CurrentRecord.Description" Rows="4" Placeholder="請輸入團隊描述" />
                        <ValidationMessage For="() => CurrentRecord.Description" />
                    </FormItem>

                    <FormItem Label="啟用狀態">
                        <Switch @bind-Value="CurrentRecord.IsEnabled" CheckedChildren="啟用" UnCheckedChildren="停用" />
                    </FormItem>
                </FormSection>
            </AntDesign.Form>
        </EditForm>
    </Modal>
}
