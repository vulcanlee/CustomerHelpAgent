@page "/Auths/ForgotPassword"
@layout NoFooterLayout
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]

<PageTitle>忘記密碼</PageTitle>

<AuthShell Title="忘記密碼" Subtitle="輸入帳號或登記的 Email，系統會寄一封重設密碼的信給您。">
    @if (!IsEmailEnabled)
    {
        <div class="error-message" role="alert">
            系統目前未啟用寄信功能，無法自助重設密碼。請聯絡系統管理員協助。
        </div>
    }
    else if (isSubmitted)
    {
        @* 不論帳號是否存在、有沒有真的寄出，一律顯示同一句話（防止用這一頁試探帳號）。
           用中性色而非綠色成功框：綠色會讓人以為信一定寄出了。 *@
        <div class="info-message" role="status">
            <p>申請已送出。若帳號存在、為啟用狀態且登記了有效的 Email，您會在幾分鐘內收到重設密碼的信，信中連結 @LifetimeMinutes 分鐘內有效。</p>
            <p>若一直沒收到（請一併檢查垃圾郵件匣），可能是帳號未登記有效的 Email，請聯絡系統管理員協助。</p>
        </div>
    }
    else
    {
        <EditForm Model="@Input" method="post" OnValidSubmit="SubmitAsync" FormName="forgot-password">
            <input type="hidden" name="Input.CaptchaCode" value="@Input.CaptchaCode" />

            <div class="form-group">
                <label class="form-label" for="identifier">帳號或 Email</label>
                <input id="identifier" name="Input.Identifier" class="form-input" placeholder="請輸入帳號或 Email"
                       @bind="Input.Identifier" autocomplete="username" />
            </div>

            <div class="form-group captcha-layout">
                <label class="form-label" for="captcha">驗證碼</label>
                <div class="captcha-group">
                    <input id="captcha" name="Input.CaptchaInput" class="form-input captcha-input" placeholder="請輸入驗證碼"
                           @bind="Input.CaptchaInput" autocomplete="off" inputmode="numeric" />
                    <div class="captcha-display" aria-label="驗證碼">
                        @captchaCode
                    </div>
                </div>
            </div>

            <div class="login-actions">
                <button class="login-button" type="submit">
                    寄出重設信
                </button>
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="error-message" role="alert">
                    @message
                </div>
            }
        </EditForm>
    }

    <div class="auth-links">
        <a class="auth-link" href="/Auths/Login">返回登入</a>
    </div>
</AuthShell>
