@page "/Auths/Login"
@layout NoFooterLayout

@inject NavigationManager NavigationManager
@attribute [ExcludeFromInteractiveRouting]
@attribute [AllowAnonymous]

<PageTitle>身分驗證</PageTitle>

<AuthShell Title="使用者登入" Subtitle="請輸入您的帳號資訊以存取系統。">
    @if (ShowResetSucceeded)
    {
        <div class="success-message" role="status">密碼已重設，請以新密碼登入。</div>
    }

    @if (SsoFailureMessage is { } ssoFailure)
    {
        <div class="alert-danger error-message" role="alert">@ssoFailure</div>
    }

    <EditForm Model="@Input" method="post" OnValidSubmit="LoginUser" FormName="login">
        <input type="hidden" name="Input.CaptchaCode" value="@Input.CaptchaCode" />

        <div class="form-group">
            <label class="form-label" for="account">帳號</label>
            <input id="account" name="Input.Account" class="form-input" placeholder="請輸入帳號"
                   @bind="Input.Account" autocomplete="username" />
        </div>

        <div class="form-group">
            <label class="form-label" for="password">密碼</label>
            <input id="password" name="Input.Password" type="password" class="form-input" placeholder="請輸入密碼"
                   @bind="Input.Password" autocomplete="current-password" />
        </div>

        <div class="form-group captcha-layout">
            <label class="form-label" for="captcha">驗證碼</label>
            <div class="captcha-group">
                <input id="captcha" name="Input.CaptchaInput" class="form-input captcha-input" placeholder="請輸入驗證碼"
                       @bind="Input.CaptchaInput" autocomplete="off" inputmode="numeric" />
                <div class="captcha-display" aria-label="驗證碼">
                    @captchaCode
                </div>
            </div>
        </div>

        <div class="form-options">
            <label class="remember-me">
                <InputCheckbox id="rememberMe" name="Input.RememberMe" @bind-Value="Input.RememberMe" />
                <span>記住我</span>
            </label>
            @if (ShowForgotPassword)
            {
                <a class="auth-link" href="/Auths/ForgotPassword">忘記密碼？</a>
            }
            else
            {
                <span class="security-note">企業級安全登入</span>
            }
        </div>

        <div class="login-actions">
            <button class="login-button" type="submit">
                登入系統
            </button>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="@errorMessage error-message" role="alert">
                @message
            </div>
        }

        <p class="lockout-hint">@LockoutHint</p>
    </EditForm>

    @if (ShowGoogleLogin)
    {
        <div class="oauth-divider"><span>或</span></div>

        <a class="google-login-button" href="@GoogleLoginUrl">
            <span class="google-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="20" height="20" role="img">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </svg>
            </span>
            <span>使用 Google 登入</span>
        </a>
    }
</AuthShell>

