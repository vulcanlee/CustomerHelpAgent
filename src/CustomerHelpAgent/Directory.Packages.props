<Project>

  <!--
    Central Package Management：所有套件版本的單一來源。
    個別 csproj 只寫 <PackageReference Include="..." />，不再帶 Version。
    升級套件請一律改這裡，避免同一套件在不同專案版本不一致。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- ASP.NET Core / EF Core（隨 .NET 版本一起升級） -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google"      Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer"   Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization"   Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"                Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi"                    Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design"            Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite"            Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools"             Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.5" />
  </ItemGroup>

  <!-- UI 與工具 -->
  <ItemGroup>
    <PackageVersion Include="AntDesign"              Version="1.6.0" />
    <PackageVersion Include="AutoMapper"             Version="16.1.1" />
    <PackageVersion Include="BlazorMaterialIcons"    Version="0.0.1" />
    <PackageVersion Include="Cronos"                 Version="0.13.0" />
    <PackageVersion Include="MailKit"                Version="4.18.0" />
    <PackageVersion Include="Markdig"                Version="1.3.2" />
    <PackageVersion Include="NLog.Web.AspNetCore"    Version="6.1.2" />
    <PackageVersion Include="Newtonsoft.Json"        Version="13.0.4" />
    <PackageVersion Include="PDFsharp-MigraDoc"      Version="6.2.4" />
    <PackageVersion Include="QRCoder"                Version="1.6.0" />
    <!-- 0.9.107 起：業務頁匯出 Excel。傳遞相依 SixLabors.Fonts 解析到 1.0.0（Apache-2.0；2.x 起改為 Split License，升級前要確認）。 -->
    <PackageVersion Include="ClosedXML"              Version="0.105.1" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <!--
    遞移相依的弱點修補（0.9.126 起）：MailKit 4.18.0 → MimeKit 4.18.0 遞移帶入
    System.Security.Cryptography.Pkcs 10.0.0，命中 GHSA-2fmv-rv2c-59x7（中）、GHSA-846f-f764-76mx（高），
    受影響 10.0.0 ~ 10.0.12，修補版 10.0.13。MimeKit 最新版（4.18.1）仍相依 10.0.0，升級 MailKit 無效，
    因此由 CustomerHelpAgent.Web 直接參考修補版覆蓋。
    移除條件：MailKit／MimeKit 改為相依 >= 10.0.13 後，連同 CustomerHelpAgent.Web.csproj 的參考一起移除。
    詳見 docs/operations/CI-CD與品質檢查.md §4.3。
  -->
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- 測試 -->
  <ItemGroup>
    <PackageVersion Include="bunit"                     Version="2.11.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk"    Version="17.14.1" />
    <PackageVersion Include="coverlet.collector"        Version="6.0.4" />
    <PackageVersion Include="xunit"                     Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
