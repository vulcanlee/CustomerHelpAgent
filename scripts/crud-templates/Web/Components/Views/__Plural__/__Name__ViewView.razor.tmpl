@* 由 scripts/New-CrudModule.ps1 產生。權限判定完成前不渲染任何內容，否則沒有權限的人會先看到頁面框架（PageAuthorizationTests 守門）。 *@
@if (!isAccessChecked)
{
}
else if (string.IsNullOrEmpty(RoleMessage) == false)
{
    <div class="alert alert-danger" role="alert">
        @RoleMessage
    </div>
}
else
{
    @* 工具列與表格容器用全域共用類別（wwwroot/theme.css 的 .view-toolbar／.view-table-wrap），不另寫 .razor.css。 *@
    <div>
        <div class="view-toolbar">
            <div class="view-toolbar-left">
                @if (!showDeleted)
                {
                    <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Create">
                        <ToolbarIconButton Title="新增" Icon="add" OnClick="@(async () => await OnAddAsync())" />
                    </RequirePermission>
                }
                <ToolbarIconButton Title="重新整理" Icon="refresh" OnClick="@(async () => await OnRefreshAsync())" />
                <ToolbarIconButton Title="匯出 Excel" Icon="file_download" OnClick="@(async () => await OnExportExcelAsync())" />
                @if (!showDeleted)
                {
                    <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Delete">
                        <BatchDeleteButton Count="@selectedRows.Count()" Busy="@batchDeleting"
                                           OnClick="@(async () => await OnBatchDeleteAsync())" />
                    </RequirePermission>
                }
                <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Delete">
                    @* 刪除為軟刪除：切換到已刪除的資料，可還原或永久刪除。 *@
                    <ToolbarIconButton Title="@(showDeleted ? "返回清單" : "顯示已刪除")"
                                       Icon="@(showDeleted ? "arrow_back" : "auto_delete")"
                                       OnClick="@(async () => await OnToggleDeletedAsync())" />
                </RequirePermission>
            </div>
            <div class="view-toolbar-right">
                <Input class="view-search-input" @bind-Value="searchText" Placeholder="請輸入搜尋關鍵字" />
                @if (!string.IsNullOrWhiteSpace(searchText))
                {
                    <ToolbarIconButton Title="清空搜尋" Icon="close"
                                       OnClick="@(async () => { searchText = string.Empty; _pageIndex = 1; await ReloadAsync(); })" />
                }
                <ToolbarIconButton Title="搜尋" Icon="search" OnClick="@(async () => await OnSearchAsync())" />
            </div>
        </div>
        <div class="view-table-wrap">
            <Table TItem="__Name__AdapterModel"
                   RemoteDataSource="true"
                   DataSource="@records"
                   OnChange="OnTableChange"
                   @bind-PageIndex="_pageIndex"
                   @bind-PageSize="_pageSize"
                   @bind-Total="_total"
                   @bind-SelectedRows="selectedRows">
                @* 勾選後可「刪除選取」；已刪除的資料不可勾選。 *@
                @if (!showDeleted)
                {
                    <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Delete">
                        <Selection />
                    </RequirePermission>
                }
                <Column TData="string" DataIndex="@nameof(__Name__AdapterModel.Name)" Title="名稱" Sortable />
                <Column TData="string" DataIndex="@nameof(__Name__AdapterModel.Description)" Title="描述" />
#IF TEAMS
                <Column TData="string" DataIndex="@nameof(__Name__AdapterModel.TeamsText)" Title="團隊" />
#ENDIF
                <Column TData="bool" DataIndex="@nameof(__Name__AdapterModel.IsEnabled)" Title="啟用狀態" Sortable>
                    @* 有修改權限時點標籤直接切換（停用先確認）；已刪除的資料不可點。 *@
                    @if (showDeleted)
                    {
                        <StatusPill Text="@(context.IsEnabled ? "啟用" : "停用")" Tone="@(context.IsEnabled ? StatusTone.Positive : StatusTone.Muted)" />
                    }
                    else
                    {
                        <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Edit">
                            <ChildContent>
                                <StatusPill Text="@(context.IsEnabled ? "啟用" : "停用")" Tone="@(context.IsEnabled ? StatusTone.Positive : StatusTone.Muted)"
                                            Hint="@(context.IsEnabled ? "點一下切換為停用" : "點一下切換為啟用")"
                                            OnClick="@(async () => await OnToggleEnabledAsync(context))" />
                            </ChildContent>
                            <Fallback>
                                <StatusPill Text="@(context.IsEnabled ? "啟用" : "停用")" Tone="@(context.IsEnabled ? StatusTone.Positive : StatusTone.Muted)" />
                            </Fallback>
                        </RequirePermission>
                    }
                </Column>
                <Column TData="DateTime" DataIndex="@nameof(__Name__AdapterModel.UpdatedAt)" Title="更新時間" Sortable DefaultSortOrder="SortDirection.Descending" />
                @if (showDeleted)
                {
                    <Column TData="DateTime?" DataIndex="@nameof(__Name__AdapterModel.DeletedAt)" Title="刪除時間" />
                    <Column TData="string" DataIndex="@nameof(__Name__AdapterModel.DeletedBy)" Title="刪除者" />
                }
                <ActionColumn Fixed="ColumnFixPlacement.Right" Title="操作">
                    <Space>
                        @if (showDeleted)
                        {
                            <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Delete">
                                <SpaceItem>
                                    <CrudActionButton Title="還原" Icon="restore_from_trash" OnClick="@(async () => await OnRestoreAsync(context))" />
                                </SpaceItem>
                                <SpaceItem>
                                    <CrudActionButton Title="永久刪除" Icon="delete_forever" Danger OnClick="@(async () => await OnPurgeAsync(context))" />
                                </SpaceItem>
                            </RequirePermission>
                        }
                        else
                        {
                            <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Edit">
                                <SpaceItem>
                                    <CrudActionButton Title="修改" Icon="edit" OnClick="@(async () => await OnEditAsync(context))" />
                                </SpaceItem>
                            </RequirePermission>
                            <RequirePermission Page="@MagicObjectHelper.__PermConst__" Action="@PermissionActions.Delete">
                                <SpaceItem>
                                    <CrudActionButton Title="刪除" Icon="delete" Danger OnClick="@(async () => await OnDeleteAsync(context))" />
                                </SpaceItem>
                            </RequirePermission>
                        }
                    </Space>
                </ActionColumn>
            </Table>
        </div>
    </div>

    @*
        大量資料輸入對話窗，規範見 docs/architecture/對話窗 UI 設計規範.md：Class 一定要有 form-modal；
        EditForm／form 上絕不可掛鍵盤事件；不適合 2 欄的欄位加 Class="form-field-full"（FormModalConventionTests、ModalKeyboardConventionTests 守門）。
    *@
    <Modal Title="@modalTitle"
           Class="form-modal"
           @bind-Visible="@modalVisible"
           Keyboard="true"
           MaskClosable="false"
           OkText="@("儲存")"
           CancelText="@("取消")"
           OnOk="OnModalOKHandleAsync"
           OnCancel="OnModalCancelHandleAsync">
        <EditForm Model="@CurrentRecord" Context="editContext">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <InputWatcher EditContextActionChanged="OnEditContestChanged" />

            <AntDesign.Form TModel="__Name__AdapterModel" Model="@CurrentRecord" Layout="FormLayout.Vertical" Context="formContext">
                <FormSection Title="基本資料">
                    <FormItem Label="名稱" Required>
                        <Input @bind-Value="CurrentRecord.Name" Placeholder="請輸入名稱" />
                        <ValidationMessage For="() => CurrentRecord.Name" />
                    </FormItem>

                    <FormItem Label="啟用狀態">
                        <Switch @bind-Value="CurrentRecord.IsEnabled" CheckedChildren="啟用" UnCheckedChildren="停用" />
                    </FormItem>

                    <FormItem Label="描述" Class="form-field-full">
                        <TextArea @bind-Value="CurrentRecord.Description" Rows="4" Placeholder="請輸入描述" />
                        <ValidationMessage For="() => CurrentRecord.Description" />
                    </FormItem>
#IF TEAMS

                    <FormItem Label="團隊" Class="form-field-full">
                        <Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
                                Values="CurrentRecord.Teams" OnSelectedItemsChanged="OnRecordTeamsChanged"
                                Placeholder="選擇看得到這筆資料的團隊（不設定表示公開）"
                                AllowClear EnableSearch Style="width: 100%;">
                            @foreach (var team in AssignableTeams)
                            {
                                <SelectOption TItemValue="string" TItem="string" Value="@team">@team</SelectOption>
                            }
                        </Select>
                    </FormItem>
#ENDIF
                </FormSection>
            </AntDesign.Form>
        </EditForm>
    </Modal>
}
